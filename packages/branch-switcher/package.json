{
  "name": "dsh-branch-switcher",
  "version": "1.0.0",
  "description": "Switch existing local Git branches from the New Session branch chip, while preserving the native worktree option.",
  "keywords": ["dsh-plugin", "dsh", "deepseek-harness", "git", "branch"],
  "license": "MIT",
  "author": "seefs001",
  "homepage": "https://github.com/seefs001/dsh-plugins/tree/main/packages/branch-switcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git",
    "directory": "packages/branch-switcher"
  },
  "bugs": { "url": "https://github.com/seefs001/dsh-plugins/issues" },
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md"],
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": ">=0.2.2-rc.2 <0.3.0" },
  "publishConfig": { "access": "public" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-experimental-client-ui-forge"
      ]
    }
  }
}
