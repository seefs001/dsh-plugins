{
  "name": "dsh-subagent-model",
  "version": "1.0.0",
  "description": "Show an addressed subagent’s recorded model and reasoning effort beside its composer.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "subagent",
    "model",
    "composer"
  ],
  "license": "MIT",
  "author": "seefs001",
  "homepage": "https://github.com/seefs001/dsh-plugins/tree/main/packages/subagent-model#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git",
    "directory": "packages/subagent-model"
  },
  "bugs": {
    "url": "https://github.com/seefs001/dsh-plugins/issues"
  },
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
