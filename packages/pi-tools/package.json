{
  "name": "dsh-pi-tools",
  "version": "0.3.0",
  "description": "An isolated pi preset for DSH with Pi coding tools, MoeJS codemode, and on-demand MCP.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "pi",
    "tools",
    "preset"
  ],
  "license": "MIT",
  "author": "seefs001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git",
    "directory": "packages/pi-tools"
  },
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:runner": "node build/runner.mjs",
    "build:runner:all": "node build/runner.mjs --all",
    "prepack": "node build/runner.mjs --check"
  },
  "files": [
    "lib",
    "bin",
    "runner",
    "build",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "executableFiles": [
      "bin/darwin-arm64/moejs",
      "bin/darwin-x64/moejs",
      "bin/linux-arm64/moejs",
      "bin/linux-x64/moejs"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dependencies": {
    "dsh-work-timeline": "workspace:^",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-codemode": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "minimatch": "11.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
