{
  "name": "dsh-work-timeline",
  "version": "0.1.0",
  "description": "Session work plans, revision timelines, and linked artifacts for DSH.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "workflow",
    "timeline",
    "artifacts"
  ],
  "license": "MIT",
  "author": "seefs001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git",
    "directory": "packages/work-timeline"
  },
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./tools/locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./tools/icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.4 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
