{
  "name": "dsh-session-groups",
  "version": "1.0.0",
  "description": "Custom session groups for the dsh Web UI, stored on the Host, with pinned sessions leading each group.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "sessions",
    "groups",
    "pin",
    "sidebar"
  ],
  "license": "MIT",
  "author": "seefs001",
  "homepage": "https://github.com/seefs001/dsh-plugins/tree/main/packages/session-groups#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git",
    "directory": "packages/session-groups"
  },
  "bugs": {
    "url": "https://github.com/seefs001/dsh-plugins/issues"
  },
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
