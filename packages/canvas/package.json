{
  "name": "dsh-canvas",
  "version": "0.1.0",
  "description": "Live sandboxed React Canvas artifacts beside DSH conversations, with TypeScript diagnostics, persistent interactive state, revision diffs, and host actions.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "canvas",
    "artifacts",
    "react",
    "visualization"
  ],
  "license": "MIT",
  "author": "seefs001",
  "homepage": "https://github.com/seefs001/dsh-plugins/tree/main/packages/canvas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git",
    "directory": "packages/canvas"
  },
  "bugs": {
    "url": "https://github.com/seefs001/dsh-plugins/issues"
  },
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
