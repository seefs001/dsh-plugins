{
  "name": "dsh-keep-awake",
  "version": "0.1.0",
  "description": "Prevents macOS idle sleep while the DSH Host is running, without keeping the display on or changing power settings.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "macos",
    "keep-awake",
    "caffeinate"
  ],
  "license": "MIT",
  "author": "seefs001",
  "homepage": "https://github.com/seefs001/dsh-plugins/tree/main/packages/keep-awake#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git",
    "directory": "packages/keep-awake"
  },
  "bugs": {
    "url": "https://github.com/seefs001/dsh-plugins/issues"
  },
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
