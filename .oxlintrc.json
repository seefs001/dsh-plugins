{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "jsPlugins": ["./scripts/oxlint-plugin.mjs"],
  "ignorePatterns": [
    "packages/canvas/lib/client.runtime.js",
    "packages/diagram-preview/lib/client.echarts.js",
    "packages/diagram-preview/lib/client.graphviz.js",
    "packages/diagram-preview/lib/client.mermaid.js",
    "packages/message-actions/lib/client.js",
    "packages/message-actions/lib/client.markdown.js",
    "packages/pi-tools/lib/generated/**",
    "apps/docs/.next/**",
    "apps/docs/.source/**",
    "apps/docs/out/**",
    "apps/docs/next-env.d.ts"
  ],
  "rules": {
    "no-unused-vars": "error",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-var": "error",
    "prefer-const": "error",
    "no-debugger": "error",
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "dsh/no-comments": "error",
    "dsh/no-suppression-comments": "error",
    "dsh/no-legacy-compat": "error",
    "dsh/no-removed-host-apis": "error",
    "dsh/require-command-available": "error",
    "dsh/no-direct-model-selection-fields": "error",
    "dsh/no-root-theme-computed-style": "error",
    "dsh/locale-dict-parity": "error",
    "dsh/no-broad-session-subscription": "error",
    "dsh/require-mobile-backdrop-fallback": "error",
    "dsh/no-unconstrained-nowrap": "error",
    "dsh/safe-intervals": "error",
    "dsh/no-new-always-on-observers": "error",
    "dsh/no-server-hot-sync-fs": "error"
  }
}
