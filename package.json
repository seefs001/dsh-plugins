{
  "name": "dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "seefs's plugin collection for DeepSeek Harness (dsh): # model references, fast mode, remembered models and recent-first @ sessions.",
  "license": "MIT",
  "author": "seefs001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seefs001/dsh-plugins.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run validate && pnpm run test",
    "lint": "oxlint --deny-warnings packages scripts test-utils",
    "validate": "node scripts/validate.mjs",
    "test": "node --test \"packages/*/test/*.test.js\"",
    "pack:dry": "pnpm --filter './packages/*' -r exec npm pack --dry-run",
    "docs:dev": "pnpm --filter @dsh-plugins/docs dev",
    "docs:build": "pnpm --filter @dsh-plugins/docs build",
    "docs:typecheck": "pnpm --filter @dsh-plugins/docs typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.93.0"
  },
  "packageManager": "pnpm@10.34.9"
}
